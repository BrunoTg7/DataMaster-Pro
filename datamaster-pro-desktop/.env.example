# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SERVICE_ROLE_KEY NÃO deve estar no desktop — usar apenas no web/server

# App
ENVIRONMENT=development
APP_VERSION=1.0.0
APP_NAME=DataMaster Pro

# Window
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# Theme
THEME=dark

# Sync
SYNC_INTERVAL_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=5000