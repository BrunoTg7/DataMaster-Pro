# DataMaster Pro - Web Configuration

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cakto (Checkout)
NEXT_PUBLIC_CAKTO_API_KEY=your-cakto-api-key
NEXT_PUBLIC_CAKTO_PRO_URL=https://pay.cakto.com.br/your-pro-url
NEXT_PUBLIC_CAKTO_PRO_ANUAL_URL=https://pay.cakto.com.br/your-pro-annual-url
NEXT_PUBLIC_CAKTO_STARTER_URL=https://pay.cakto.com.br/your-starter-url
NEXT_PUBLIC_CAKTO_STARTER_ANUAL_URL=https://pay.cakto.com.br/your-starter-annual-url
CAKTO_WEBHOOK_SECRET=your-webhook-secret

# Security
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
HEALTH_CHECK_SECRET=GENERATE_A_REAL_SECRET_HERE
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
COOKIE_ENCRYPTION_KEY=GENERATE_A_REAL_SECRET_HERE_64_HEX_CHARS

# Upstash Redis (rate limiting - optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=https://datamaster.pro

# Environment
NODE_ENV=development
